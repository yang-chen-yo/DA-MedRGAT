# Copy to .env and fill in your own keys.
# Non-secret values below are the settings used for the reported results.

# --- API keys (required, keep private) ---
GOOGLE_API_KEY=
PUBMED_API_KEY=
# Contact email sent to NCBI E-utilities (required by NCBI usage policy)
NCBI_EMAIL=

# --- Data ---
MIMIC4_ROOT=./data/mimic-iv-3.1/hosp

# --- Triple-generation LLM (reported results: gemma-3-4b-it, temperature 0) ---
TRIPLE_LLM_BACKEND=gemini
GEMINI_MODEL=gemma-3-4b-it
GEMINI_MIN_INTERVAL_SEC=6
GEMINI_MAX_RETRIES=4
GEMINI_BATCH_SIZE=1

# --- Retrieval and KG expansion ---
K_PUBMED=5
PUBMED_MIN_SIM=0.30
KG_MAX_HOPS=3
KG_FRONTIER_TOPK=8
KG_HOP_K_PUBMED=5

# --- Verifier ---
VERIFIER_ACCEPT_THRESHOLD=0.90
VERIFIER_REVIEW_THRESHOLD=0.50
VERIFIER_CONTRA_THRESHOLD=0.70

# --- Optional alternative backend (not used for the reported results) ---
# Any server exposing /v1/chat/completions (Ollama, vLLM, llama.cpp, LM Studio).
# TRIPLE_LLM_BACKEND=openai_compat
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen2.5:7b-instruct
# LOCAL_LLM_TIMEOUT=180
